# Noesis API Authentication
# Generate a token from Settings > API Tokens in the Noesis web UI
NOESIS_API_TOKEN=noe_your_token_here
# Use cloud URL for production, localhost for local development
NOESIS_API_URL=https://noesisbrain.com
# NOESIS_API_URL=http://localhost:5555  # Local development

# Gemini API key for semantic search (optional)
GEMINI_API_KEY=your_gemini_api_key_here
